{
  "name": "orwel",
  "version": "1.0.17",
  "changelog": "CHANGELOG.md",
  "description": "Lightweight JavaScript SDK for sending events to Orwel's real-time monitoring API.",
  "main": "./dist/orwel.umd.js",
  "module": "./dist/orwel.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/orwel.es.js",
      "require": "./dist/orwel.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "orwel",
    "sdk",
    "analytics",
    "event-tracking",
    "marketing",
    "monitoring"
  ],
  "author": "orwel.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperlabs-ai/orwel-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hyperlabs-ai/orwel-sdk/issues"
  },
  "homepage": "https://github.com/hyperlabs-ai/orwel-sdk#readme",
  "dependencies": {
    "uuid": "^11.1.0",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "typescript": "^5.8.3",
    "vite": "^5.0.0"
  }
}
