{
  "name": "orwel",
  "version": "1.2.0",
  "changelog": "CHANGELOG.md",
  "description": "Human-behavior event tracking SDK",
  "main": "./dist/orwel.umd.js",
  "module": "./dist/orwel.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/orwel.es.js",
      "require": "./dist/orwel.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "orwel",
    "sdk",
    "analytics",
    "event-tracking",
    "marketing",
    "monitoring"
  ],
  "author": "orwel.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperlabs-ai/orwel-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hyperlabs-ai/orwel-sdk/issues"
  },
  "homepage": "https://github.com/hyperlabs-ai/orwel-sdk#readme",
  "dependencies": {
    "uuid": "^11.1.0",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-typescript": "^7.23.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.16.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.3",
    "vite": "^5.0.0"
  }
}

